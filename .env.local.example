NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SHARE_URL=https://certnow.uk
# Google sign-in (ID-token flow via Google Identity Services).
# Create an OAuth "Web application" client in Google Cloud Console, add your
# origins to "Authorized JavaScript origins" (e.g. https://certnow.uk and
# http://localhost:3000), then paste the Client ID here. Also add this same
# Client ID to Supabase → Auth → Providers → Google → "Client IDs".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Server-side Supabase (optional if same as public)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=ey...
SUPABASE_SERVICE_ROLE_KEY=ey...

# Address lookup
IDEAL_POSTCODES_API_KEY=your-ideal-postcodes-api-key
# Set to false to disable Ideal Postcodes lookups in Preview/test.
# ADDRESS_LOOKUP_ENABLED=false
# Legacy flag still supported; prefer ADDRESS_LOOKUP_ENABLED=false.
# DISABLE_ADDRESS_LOOKUP=true

# Test/demo UI
# NEXT_PUBLIC_SHOW_DEMO_AUTOFILL=true

# Email delivery (optional; public request confirmations/reminders)
# RESEND_API_KEY=re_...
# EMAIL_FROM="CertNow <notifications@certnow.uk>"

# Error monitoring (optional)
# NEXT_PUBLIC_SENTRY_DSN=https://public-key@o000000.ingest.sentry.io/000000
# SENTRY_DSN=https://public-key@o000000.ingest.sentry.io/000000
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_TRACES_SAMPLE_RATE=0.1
# SENTRY_ENVIRONMENT=local
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
# Required only if uploading production source maps during Vercel builds.
# SENTRY_AUTH_TOKEN=sntrys_...
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=certnow

# Marketing / traffic analytics — PostHog (optional; absent key = clean no-op).
# Create an EU-region project at https://eu.posthog.com (keeps UK/EU visitor
# data in-region for UK-GDPR). Project Settings → paste the "Project API Key".
# Runs cookieless (no consent banner) with session replay fully masked.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# AI summarization (optional)
OPENAI_API_KEY=sk-proj-...
